# Replace with a URL-safe random password. Do not commit .env.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
APP_PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
COOKIE_SECURE=false
SCRIPT_TIMEOUT=180
# Directory containing BEFORE_MASTER and AFTER_BETA, not its parent RUN directory.
DATA_DIR=./Исходники/data/RUN-20260827-0001/RESULTS
# Optional OpenAI-compatible chat/completions endpoint, server/worker only.
AI_API_URL=
AI_PROVIDER=openai-compatible
AI_FOLDER_ID=
AI_API_KEY=
AI_MODEL=

# Self-service is deliberately disabled on a developer laptop by default.
PUBLIC_MODE=false
ALLOW_REGISTRATION=false
PUBLIC_DATASET_IDS=
FORWARDED_ALLOW_IPS=127.0.0.1
API_REQUESTS_PER_MINUTE=600
USER_REQUESTS_PER_MINUTE=600
LOGIN_ATTEMPTS_PER_15_MIN=20
LOGIN_ATTEMPTS_GLOBAL_PER_MIN=60
REGISTRATIONS_PER_IP_HOUR=3
REGISTRATIONS_PER_DAY=100
MAX_PENDING_JOBS=50
MAX_PENDING_JOBS_PER_USER=2
MAX_RUNS_PER_USER=10
COMPUTE_JOBS_PER_USER_HOUR=30
AI_REQUESTS_PER_USER_DAY=10
AI_REQUESTS_GLOBAL_DAY=50
AI_TOKENS_PER_USER_DAY=30000
AI_TOKENS_GLOBAL_DAY=200000
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_INPUT_TOKENS=20000
MAX_REQUEST_BYTES=1048576
# Paired JSON uploads (ZIP); independent of the ordinary JSON request limit.
MAX_DATASET_ARCHIVE_BYTES=33554432
MAX_DATASET_EXPANDED_BYTES=67108864
MAX_DATASET_PAIRS=20000
MAX_DATASETS_PER_USER=5
MAX_DATASET_STORAGE_BYTES=268435456
DATASET_UPLOADS_PER_USER_HOUR=10
CHECK_OUTPUT_LIMIT=8388608
BACKUP_KEEP=7
BACKUP_DIR=./runtime/backups/postgres
